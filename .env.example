# =============================================================================
# AiPal Mail Server — local configuration
# Copy to `.env` (which is gitignored) and edit. Scripts source this file.
#   cp .env.example .env
# =============================================================================

# --- Domains -----------------------------------------------------------------
DOMAIN=aipalassist.com
MAIL_HOSTNAME=mail.aipalassist.com

# Autodiscover/autoconfig hostnames (optional but recommended for Outlook clients)
ADDITIONAL_SERVER_NAMES=autodiscover.aipalassist.com,autoconfig.aipalassist.com

# --- Server ------------------------------------------------------------------
# Leave blank to auto-detect via `curl -4 ifconfig.me`
VPS_IP=187.55.230.139
MAILCOW_TZ=Europe/Paris

# --- Mailcow paths / ports ---------------------------------------------------
# Mailcow sits BEHIND Caddy, so it must not bind public 80/443.
MAILCOW_DIR=/opt/mailcow-dockerized
MAILCOW_HTTP_BIND=127.0.0.1
MAILCOW_HTTP_PORT=8080
MAILCOW_HTTPS_BIND=127.0.0.1
MAILCOW_HTTPS_PORT=8443

# --- Caddy (already running on this host and serving other sites) ------------
CADDYFILE=/etc/caddy/Caddyfile
CADDY_ENV_FILE=/etc/caddy/status-auth.env
CADDY_CERT_DIR=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory

# --- Mail policy -------------------------------------------------------------
DMARC_RUA_MAILBOX=dmarc@aipalassist.com
# Start at p=none while validating, then tighten to p=quarantine.
DMARC_POLICY=none

# --- Mailcow API (set after first login: UI -> Configuration -> API) ---------
MAILCOW_API_KEY=
MAILCOW_API_URL=https://mail.aipalassist.com/api/v1
